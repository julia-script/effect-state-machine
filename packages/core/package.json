{
  "name": "effect-state-machine",
  "version": "0.2.0",
  "description": "A small code-first state-machine library built with Effect for Effect users.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/effect-state-machine.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/julia-script/effect-state-machine/tree/main/packages/core",
  "bugs": "https://github.com/julia-script/effect-state-machine/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./devtools": "./src/devtools.ts",
    "./Machine": "./src/Machine.ts",
    "./MachineEngine": "./src/MachineEngine.ts",
    "./MachineStore": "./src/MachineStore.ts",
    "./LocalStorageMachineStore": "./src/LocalStorageMachineStore.ts",
    "./MachineWorkflow": "./src/MachineWorkflow.ts",
    "./Graph": "./src/Graph.ts",
    "./Mermaid": "./src/Mermaid.ts",
    "./SourceLocation": "./src/SourceLocation.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./devtools": {
        "types": "./dist/devtools.d.ts",
        "import": "./dist/devtools.js"
      },
      "./Machine": {
        "types": "./dist/Machine.d.ts",
        "import": "./dist/Machine.js"
      },
      "./MachineEngine": {
        "types": "./dist/MachineEngine.d.ts",
        "import": "./dist/MachineEngine.js"
      },
      "./MachineStore": {
        "types": "./dist/MachineStore.d.ts",
        "import": "./dist/MachineStore.js"
      },
      "./LocalStorageMachineStore": {
        "types": "./dist/LocalStorageMachineStore.d.ts",
        "import": "./dist/LocalStorageMachineStore.js"
      },
      "./MachineWorkflow": {
        "types": "./dist/MachineWorkflow.d.ts",
        "import": "./dist/MachineWorkflow.js"
      },
      "./Graph": {
        "types": "./dist/Graph.d.ts",
        "import": "./dist/Graph.js"
      },
      "./Mermaid": {
        "types": "./dist/Mermaid.d.ts",
        "import": "./dist/Mermaid.js"
      },
      "./SourceLocation": {
        "types": "./dist/SourceLocation.d.ts",
        "import": "./dist/SourceLocation.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "dev": "tsc --noEmit --watch",
    "check": "pnpm typecheck && pnpm test && pnpm check:quality && pnpm check:boundaries && pnpm check:api-prototype && pnpm check:package",
    "check:boundaries": "node scripts/check-internal-boundaries.mjs",
    "check:quality": "biome check . --error-on-warnings",
    "check:api-prototype": "node scripts/check-api-prototype.mjs",
    "check:package": "pnpm build && node scripts/check-package.mjs",
    "graph:reference": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.110"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.110",
    "effect": "4.0.0-rc.110",
    "esbuild": "0.28.1",
    "source-map-js": "^1.2.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
