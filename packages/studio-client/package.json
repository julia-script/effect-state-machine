{
  "name": "@effect-state-machine/studio-client",
  "version": "0.1.1",
  "description": "Connects running effect-state-machine machines to Studio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/effect-state-machine.git",
    "directory": "packages/studio-client"
  },
  "homepage": "https://github.com/julia-script/effect-state-machine/tree/main/packages/studio-client",
  "bugs": "https://github.com/julia-script/effect-state-machine/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc --noEmit --watch",
    "check": "pnpm typecheck && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "esbuild examples/checkout-demo.ts --bundle --platform=node --format=esm --target=node22 --external:effect --outfile=dist-demo/checkout-demo.mjs && node dist-demo/checkout-demo.mjs"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.106",
    "effect-state-machine": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.106",
    "@effect/vitest": "4.0.0-beta.106",
    "effect": "4.0.0-beta.106",
    "effect-state-machine": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "esbuild": "0.28.1"
  }
}
