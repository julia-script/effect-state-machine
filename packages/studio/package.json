{
  "name": "@effect-state-machine/studio",
  "version": "0.1.0",
  "description": "Studio — the standalone devtool for effect-state-machine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/effect-state-machine.git",
    "directory": "packages/studio"
  },
  "homepage": "https://github.com/julia-script/effect-state-machine/tree/main/packages/studio",
  "bugs": "https://github.com/julia-script/effect-state-machine/issues",
  "type": "module",
  "bin": {
    "effect-state-machine-studio": "./bin/studio.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && vite build && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/cli.js --external:effect --external:@effect/platform-node",
    "dev": "vite",
    "check": "pnpm typecheck && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.106",
    "effect": "4.0.0-beta.106"
  },
  "devDependencies": {
    "@effect-state-machine/studio-client": "workspace:*",
    "@effect-state-machine/studio-react": "workspace:*",
    "effect-state-machine": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@effect/vitest": "4.0.0-beta.106",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
